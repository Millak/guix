msgstr "'--user'는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1227
#, scheme-format
msgid "'--cwd' cannot be used without '--container'~%"
msgstr "'--cwd'는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1229
#, scheme-format
msgid "--no-cwd cannot be used without '--container'~%"
msgstr "--no-cwd는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1231
#, scheme-format
msgid "'--writable-root' cannot be used without '--container'~%"
msgstr "'--writable-root'는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1233
#, scheme-format
msgid "'--emulate-fhs' cannot be used without '--container'~%"
msgstr "'--emulate-fhs'는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1235
#, scheme-format
msgid "'--nesting' cannot be used without '--container'~%"
msgstr "'--nesting'은 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1237
#, scheme-format
msgid "'--symlink' cannot be used without '--container'~%"
msgstr "'--symlink'는 '--container' 없이 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1251
#, scheme-format
msgid "'--profile' cannot be used with package options~%"
msgstr "'--profile'은 패키지 옵션과 함께 사용할 수 없습니다~%"

#: guix/scripts/environment.scm:1295
#, scheme-format
msgid "'--check' is unnecessary when using '--container'; doing nothing~%"
msgstr ""
"'--container'를 사용할 때는 '--check'가 불필요합니다; 아무 작업도 하지 않습니"
"다~%"

#: guix/scripts/style.scm:118
