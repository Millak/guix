#: gnu/system/linux-container.scm:300
#, scheme-format
msgid ""
"Run 'sudo guix container exec ~a /run/current-system/profile/bin/bash --"
"login'\n"
msgstr ""
"'sudo guix container exec ~a /run/current-system/profile/bin/bash --login'을 "
"실행하십시오\n"

