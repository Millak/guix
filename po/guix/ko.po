msgstr "현재 시스템의 출처를 확인할 수 없습니다~%"

#: guix/scripts/system/reconfigure.scm:441
#, scheme-format
msgid "cannot determine provenance of ~a~%"
msgstr "~a의 출처를 확인할 수 없습니다~%"

#: guix/scripts/lint.scm:61
#, scheme-format
msgid "~a@~a: ~a~%"
msgstr "~a@~a: ~a~%"

#: guix/scripts/lint.scm:85
#, scheme-format
msgid "Available checkers:~%"
msgstr "사용 가능한 검사기:~%"

#: guix/scripts/lint.scm:110
msgid "breaks from alphabetical order"
msgstr "알파벳 순서에서 벗어남"

#: guix/scripts/lint.scm:125
msgid ""
"Usage: guix lint [OPTION]... [PACKAGE]...\n"
"Run a set of checkers on the specified package; if none is specified,\n"
"run the checkers on all packages.\n"
msgstr ""
"사용법: guix lint [옵션]... [패키지]...\n"
"지정된 패키지에 대해 검사기 세트를 실행합니다. 지정하지 않으면\n"
"모든 패키지에 대해 검사기를 실행합니다.\n"

#: guix/scripts/lint.scm:128
msgid ""
"\n"
"  -c, --checkers=CHECKER1,CHECKER2...\n"
"                         only run the specified checkers"
msgstr ""
"\n"
"  -c, --checkers=CHECKER1,CHECKER2...\n"
"                         지정된 검사기만 실행"

#: guix/scripts/lint.scm:131
msgid ""
"\n"
"  -x, --exclude=CHECKER1,CHECKER2...\n"
"                         exclude the specified checkers"
msgstr ""
"\n"
"  -x, --exclude=CHECKER1,CHECKER2...\n"
"                         지정된 검사기 제외"

#: guix/scripts/lint.scm:134
msgid ""
"\n"
"  -n, --no-network       only run checkers that do not access the network"
msgstr ""
"\n"
"  -n, --no-network       네트워크에 접속하지 않는 검사기만 실행"

#: guix/scripts/lint.scm:136 guix/scripts/graph.scm:529
#: guix/scripts/pack.scm:1661 guix/scripts/style.scm:833
#: guix/scripts/refresh.scm:160
msgid ""
"\n"
"  -e, --expression=EXPR  consider the package EXPR evaluates to"
msgstr ""
"\n"
"  -e, --expression=EXPR  EXPR이 평가하는 패키지를 고려"

#: guix/scripts/lint.scm:142
msgid ""
"\n"
"  -f, --whole-file       check the packages defined in the given file(s)"
msgstr ""
"\n"
"  -f, --whole-file       주어진 파일에 정의된 패키지 검사"

#: guix/scripts/lint.scm:147
msgid ""
"\n"
"  -l, --list-checkers    display the list of available lint checkers"
msgstr ""
"\n"
"  -l, --list-checkers    사용 가능한 린트 검사기 목록 표시"

#: guix/scripts/lint.scm:166
#, scheme-format
msgid "~a: invalid checker~%"
msgstr "~a: 유효하지 않은 검사기~%"

#: guix/scripts/lint.scm:213
msgid "validate package definitions"
msgstr "패키지 정의 검증"

#: guix/scripts/lint.scm:262 guix/scripts/style.scm:887
#, scheme-format
msgid "no files specified, nothing to do~%"
msgstr "지정된 파일이 없어 수행할 작업이 없습니다~%"

#: guix/scripts/locate.scm:132
#, scheme-format
msgid "~a: database is locked by another process~%"
msgstr "~a: 데이터베이스가 다른 프로세스에 의해 잠겼습니다~%"

#: guix/scripts/locate.scm:256
#, scheme-format
msgid "schema version:\t~a~%"
msgstr "스키마 버전:\t~a~%"

#: guix/scripts/locate.scm:258
msgid "number of packages:\t~9h~%"
msgstr "패키지 수:\t~9h~%"

#: guix/scripts/locate.scm:260
msgid "number of files:\t~9h~%"
msgstr "파일 수:\t~9h~%"

#: guix/scripts/locate.scm:262
msgid "database size:\t~9h MiB~%"
msgstr "데이터베이스 크기:\t~9h MiB~%"

#: guix/scripts/locate.scm:389
msgid "indexing ~h packages"
msgstr "~h개 패키지 인덱싱 중"

#: guix/scripts/locate.scm:467
#, scheme-format
msgid "traversing local profile manifests...~%"
msgstr "로컬 프로필 매니페스트 순회 중...~%"

#: guix/scripts/locate.scm:539
msgid ""
"Usage: guix locate [OPTIONS...] FILE...\n"
"Locate FILE and return the list of packages that contain it.\n"
msgstr ""
"사용법: guix locate [옵션...] 파일...\n"
"파일을 찾아 해당 파일을 포함하는 패키지 목록을 반환합니다.\n"

#: guix/scripts/locate.scm:541
msgid ""
"\n"
"  -g, --glob          interpret FILE as a glob pattern"
msgstr ""
"\n"
"  -g, --glob          파일을 glob 패턴으로 해석"

#: guix/scripts/locate.scm:543
msgid ""
"\n"
"      --stats         display database statistics"
msgstr ""
"\n"
"      --stats         데이터베이스 통계 표시"

#: guix/scripts/locate.scm:545
msgid ""
"\n"
"  -u, --update        force a database update"
msgstr ""
"\n"
"  -u, --update        데이터베이스 업데이트 강제"

#: guix/scripts/locate.scm:547
msgid ""
"\n"
"      --clear         clear the database"
msgstr ""
"\n"
"      --clear         데이터베이스 지우기"

#: guix/scripts/locate.scm:549
msgid ""
"\n"
"      --database=FILE store the database in FILE"
msgstr ""
"\n"
"      --database=FILE 데이터베이스를 파일에 저장"

#: guix/scripts/locate.scm:552
msgid ""
"\n"
"      --method=METHOD use METHOD to select packages to index; METHOD can\n"
"                      be 'manifests' (fast) or 'store' (slower)"
msgstr ""
"\n"
"      --method=METHOD 인덱싱할 패키지를 선택하는 데 METHOD 사용. METHOD는\n"
"                      'manifests'(빠름) 또는 'store'(느림)일 수 있음"

#: guix/scripts/locate.scm:556
msgid ""
"\n"
"  -h, --help          display this help and exit"
msgstr ""
"\n"
"  -h, --help          이 도움말을 표시하고 종료"

#: guix/scripts/locate.scm:558
msgid ""
"\n"
"  -V, --version       display version information and exit"
msgstr ""
"\n"
"  -V, --version       버전 정보를 표시하고 종료"

#: guix/scripts/locate.scm:591 guix/scripts/locate.scm:646
#, scheme-format
msgid "~a: unknown indexing method~%"
msgstr "~a: 알 수 없는 인덱싱 방법입니다~%"

