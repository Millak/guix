"\n"
"  -r, --recursive        패키지들을 재귀적으로 가져옵니다"

#: guix/scripts/import/cran.scm:53
msgid ""
"\n"
"  -s, --style=STYLE      choose output style, either specification or "
"variable"
msgstr ""
"\n"
"  -s, --style=STYLE      출력 스타일로 specification 또는 variable 중 하나를 "
"선택합니다"

#: guix/scripts/import/cran.scm:55
msgid ""
"\n"
"  -p, --license-prefix=PREFIX\n"
"                         add custom prefix to licenses"
msgstr ""
"\n"
"  -p, --license-prefix=PREFIX\n"
"                         라이선스에 사용자 지정 접두사를 추가합니다"

#: guix/scripts/import/cran.scm:131 guix/scripts/import/texlive.scm:97
