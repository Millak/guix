msgid "   container        build a container that shares the host's store\n"
msgstr "   container        호스트의 저장소를 공유하는 컨테이너를 빌드합니다\n"

#: guix/scripts/system.scm:1003
msgid ""
"   vm               build a virtual machine image that shares the host's "
"store\n"
msgstr ""
"   vm               호스트의 저장소를 공유하는 가상 머신 이미지를 빌드합니"
"다\n"

#: guix/scripts/system.scm:1005
msgid "   image            build a Guix System image\n"
msgstr "   image            Guix 시스템 이미지를 빌드합니다\n"

#: guix/scripts/system.scm:1007
msgid "   docker-image     build a Docker image\n"
msgstr "   docker-image     Docker 이미지를 빌드합니다\n"

#: guix/scripts/system.scm:1009
msgid "   init             initialize a root file system to run GNU\n"
msgstr ""
"   init             GNU를 실행하기 위한 루트 파일 시스템을 초기화합니다\n"

#: guix/scripts/system.scm:1011
msgid "   installer        run the graphical installer\n"
msgstr "   installer        그래픽 설치 프로그램을 실행합니다\n"

#: guix/scripts/system.scm:1013
msgid "   extension-graph  emit the service extension graph in Dot format\n"
msgstr "   extension-graph  서비스 확장 그래프를 Dot 형식으로 출력합니다\n"

#: guix/scripts/system.scm:1015
msgid "   shepherd-graph   emit the graph of shepherd services in Dot format\n"
msgstr "   shepherd-graph   shepherd 서비스 그래프를 Dot 형식으로 출력합니다\n"

#: guix/scripts/system.scm:1019
msgid ""
"\n"
"  -d, --derivation       return the derivation of the given system"
msgstr ""
"\n"
"  -d, --derivation       지정된 시스템의 파생(derivation)을 반환합니다"

#: guix/scripts/system.scm:1021
msgid ""
"\n"
"  -e, --expression=EXPR  consider the operating-system EXPR evaluates to\n"
"                         instead of reading FILE, when applicable"
msgstr ""
"\n"
"  -e, --expression=EXPR  해당하는 경우, 파일을 읽는 대신 EXPR을 평가한\n"
"                         결과인 운영 체제를 대상으로 삼습니다"

#: guix/scripts/system.scm:1024 guix/scripts/home.scm:138
msgid ""
"\n"
"      --allow-downgrades for 'reconfigure', allow downgrades to earlier\n"
"                         channel revisions"
msgstr ""
"\n"
"      --allow-downgrades 'reconfigure' 시, 이전 채널 리비전으로의\n"
"                         다운그레이드를 허용합니다"

#: guix/scripts/system.scm:1027
msgid ""
"\n"
"      --on-error=STRATEGY\n"
"                         apply STRATEGY (one of nothing-special, backtrace,\n"
"                         or debug) when an error occurs while reading FILE"
msgstr ""
"\n"
"      --on-error=STRATEGY\n"
"                         파일을 읽는 도중 오류가 발생하면 STRATEGY\n"
"                         (nothing-special, backtrace, debug 중 하나)를 적용합"
"니다"

#: guix/scripts/system.scm:1031
msgid ""
"\n"
"      --list-image-types list available image types"
msgstr ""
"\n"
"      --list-image-types 사용 가능한 이미지 형식 목록을 보여줍니다"

#: guix/scripts/system.scm:1033
msgid ""
"\n"
"  -t, --image-type=TYPE  for 'image', produce an image of TYPE"
msgstr ""
"\n"
"  -t, --image-type=TYPE  'image' 명령에 대해 TYPE 형식의 이미지를 생성합니다"

#: guix/scripts/system.scm:1035
msgid ""
"\n"
"      --image-size=SIZE  for 'image', produce an image of SIZE"
msgstr ""
"\n"
"      --image-size=SIZE  'image' 명령에 대해 SIZE 크기의 이미지를 생성합니다"

#: guix/scripts/system.scm:1037
msgid ""
"\n"
"      --no-bootloader    for 'init', do not install a bootloader"
msgstr ""
"\n"
"      --no-bootloader    'init' 명령에 대해 부트로더를 설치하지 않습니다"

#: guix/scripts/system.scm:1039
msgid ""
"\n"
"      --no-kexec         for 'reconfigure', do not load system for kexec "
"reboot"
msgstr ""
"\n"
"      --no-kexec         'reconfigure' 시, kexec 재부팅을 위해 시스템을\n"
"                         로드하지 않습니다"

#: guix/scripts/system.scm:1041
msgid ""
"\n"
"      --volatile         for 'image', make the root file system volatile"
msgstr ""
"\n"
"      --volatile         'image' 명령에 대해 루트 파일 시스템을 휘발성으로 만"
"듭니다"

#: guix/scripts/system.scm:1043
msgid ""
"\n"
"      --persistent       for 'vm', make the root file system persistent"
msgstr ""
"\n"
"      --persistent       'vm' 명령에 대해 루트 파일 시스템을 영속성으로 만듭"
"니다"

#: guix/scripts/system.scm:1045
msgid ""
"\n"
"      --label=LABEL      for 'image', label disk image with LABEL"
msgstr ""
"\n"
"      --label=LABEL      'image' 명령에 대해 디스크 이미지에 LABEL 레이블을 "
"붙입니다"

#: guix/scripts/system.scm:1047 guix/scripts/pack.scm:1672
msgid ""
"\n"
"      --save-provenance  save provenance information"
msgstr ""
"\n"
"      --save-provenance  출처 정보를 저장합니다"

#: guix/scripts/system.scm:1049
msgid ""
"\n"
"      --share=SPEC       for 'vm' and 'container', share host file system "
"with\n"
"                         read/write access according to SPEC"
msgstr ""
"\n"
"      --share=SPEC       'vm' 및 'container'에 대해 SPEC에 따라\n"
"                         읽기/쓰기 권한으로 호스트 파일 시스템을 공유합니다"

#: guix/scripts/system.scm:1052
msgid ""
"\n"
"      --expose=SPEC      for 'vm' and 'container', expose host file system\n"
"                         directory as read-only according to SPEC"
msgstr ""
"\n"
"      --expose=SPEC      'vm' 및 'container'에 대해 SPEC에 따라\n"
"                         읽기 전용으로 호스트 파일 시스템 디렉터리를 노출합니"
"다"

#: guix/scripts/system.scm:1055
msgid ""
"\n"
"  -N, --network          for 'container', allow containers to access the "
"network"
msgstr ""
"\n"
"  -N, --network          'container' 명령에 대해 컨테이너의 네트워크\n"
"                         접근을 허용합니다"

#: guix/scripts/system.scm:1057
msgid ""
"\n"
"  -r, --root=FILE        for 'vm', 'image', 'container' and 'build',\n"
"                         make FILE a symlink to the result, and\n"
"                         register it as a garbage collector root"
msgstr ""
"\n"
"  -r, --root=FILE        'vm', 'image', 'container', 'build' 명령에 대해\n"
"                         파일을 결과에 대한 심볼릭 링크로 만들고,\n"
"                         이를 가비지 컬렉터 루트로 등록합니다"

#: guix/scripts/system.scm:1061
msgid ""
"\n"
"      --full-boot        for 'vm', make a full boot sequence"
msgstr ""
"\n"
"      --full-boot        'vm'의 경우, 전체 부팅 시퀀스 생성"

#: guix/scripts/system.scm:1063
msgid ""
"\n"
"      --no-graphic       for 'vm', use the tty that we are started in for IO"
msgstr ""
"\n"
"      --no-graphic       'vm'의 경우, 입출력에 시작된 tty를 사용"

#: guix/scripts/system.scm:1065
msgid ""
"\n"
"      --skip-checks      skip file system and initrd module safety checks"
msgstr ""
"\n"
"      --skip-checks      파일 시스템 및 initrd 모듈 안전 검사 건너뛰기"

#: guix/scripts/system.scm:1070 guix/scripts/home.scm:153
msgid ""
"\n"
"      --graph-backend=BACKEND\n"
"                         use BACKEND for 'extension-graph' and 'shepherd-"
"graph'"
msgstr ""
"\n"
"      --graph-backend=BACKEND\n"
"                         'extension-graph' 및 'shepherd-graph'에 BACKEND 사용"

#: guix/scripts/system.scm:1074
msgid ""
"\n"
"  -I, --list-installed[=REGEXP]\n"
"                         for 'describe' and 'list-generations', list "
"installed\n"
"                         packages matching REGEXP"
msgstr ""
"\n"
"  -I, --list-installed[=REGEXP]\n"
"                         'describe' 및 'list-generations'의 경우, REGEXP에 일"
"치하는\n"
"                         설치된 패키지 나열"

#: guix/scripts/system.scm:1231
msgid ""
"\n"
"      --help-docker-format list options specific to the docker image type."
msgstr ""
"\n"
"      --help-docker-format docker 이미지 유형에 고유한 옵션을 나열합니다."

#: guix/scripts/system.scm:1235
msgid ""
"\n"
"      --max-layers=N\n"
"                         Number of image layers"
msgstr ""
"\n"
"      --max-layers=N\n"
"                         이미지 레이어의 수"

#: guix/scripts/system.scm:1269
#, scheme-format
msgid "'~a' does not return an operating system or an image~%"
msgstr "'~a'은(는) 운영 체제 또는 이미지를 반환하지 않습니다~%"

