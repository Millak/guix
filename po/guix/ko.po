msgstr "패키지 '~a'이(가) 더 이상 존재하지 않습니다~%"

#: guix/scripts/package.scm:323
#, scheme-format
msgid ""
"Consider setting the necessary environment\n"
"variables by running:\n"
"\n"
"@example\n"
"GUIX_PROFILE=\"~a\"\n"
". \"$GUIX_PROFILE/etc/profile\"\n"
"unset GUIX_PROFILE\n"
"@end example\n"
"\n"
"Alternately, see @command{guix package --search-paths -p ~s}."
msgstr ""
"다음을 실행하여 필요한 환경 변수를\n"
"설정하는 것을 고려해 보십시오:\n"
"\n"
"@example\n"
"GUIX_PROFILE=\"~a\"\n"
". \"$GUIX_PROFILE/etc/profile\"\n"
"unset GUIX_PROFILE\n"
"@end example\n"
"\n"
"또는 @command{guix package --search-paths -p ~s}을(를) 참조하십시오."

#: guix/scripts/package.scm:354
msgid ""
";; This \"manifest\" file can be passed to 'guix package -m' to reproduce\n"
";; the content of your profile.  This is \"symbolic\": it only specifies\n"
";; package names.  To reproduce the exact same profile, you also need to\n"
";; capture the channels being used, as returned by \"guix describe\".\n"
";; See the \"Replicating Guix\" section in the manual.\n"
msgstr ""
";; 이 \"manifest\" 파일은 귀하의 프로필 내용을 재현하기 위해 'guix package "
"-m'에\n"
";; 전달될 수 있습니다. 이는 \"상징적(symbolic)\"입니다: 패키지 이름만 지정합"
"니다.\n"
";; 정확히 동일한 프로필을 재현하려면 \"guix describe\"가 반환하는 사용 중인 "
"채널도\n"
";; 캡처해야 합니다. 설명서의 \"Guix 복제\" 섹션을 참조하십시오.\n"

#: guix/scripts/package.scm:386
#, scheme-format
msgid "no provenance information for this profile~%"
msgstr "이 프로필에 대한 출처 정보가 없습니다~%"

#: guix/scripts/package.scm:388
msgid ""
";; This channel file can be passed to 'guix pull -C' or to\n"
";; 'guix time-machine -C' to obtain the Guix revision that was\n"
";; used to populate this profile.\n"
msgstr ""
";; 이 채널 파일은 이 프로필을 채우는 데 사용된 Guix 리비전을 가져오기 위해\n"
";; 'guix pull -C' 또는 'guix time-machine -C'에 전달될 수 있습니다.\n"

#: guix/scripts/package.scm:400
#, scheme-format
msgid ""
";; Note: these other commits were also used to install some of the packages "
"in this profile:~%"
msgstr ""
";; 참고: 이 프로필의 일부 패키지를 설치하기 위해 다음 커밋들도 사용되었습니"
"다:~%"

#: guix/scripts/package.scm:430
msgid ""
"Usage: guix package [OPTION]...\n"
"Install, remove, or upgrade packages in a single transaction.\n"
msgstr ""
"사용법: guix package [옵션]...\n"
"단일 트랜잭션에서 패키지를 설치, 제거 또는 업그레이드합니다.\n"

#: guix/scripts/package.scm:432
msgid ""
"\n"
"  -i, --install PACKAGE ...\n"
"                         install PACKAGEs"
msgstr ""
"\n"
"  -i, --install PACKAGE ...\n"
"                         패키지 설치"

#: guix/scripts/package.scm:435
msgid ""
"\n"
"  -e, --install-from-expression=EXP\n"
"                         install the package EXP evaluates to"
msgstr ""
"\n"
"  -e, --install-from-expression=EXP\n"
"                         EXP가 평가하는 패키지 설치"

#: guix/scripts/package.scm:438
msgid ""
"\n"
"  -f, --install-from-file=FILE\n"
"                         install the package that the code within FILE\n"
"                         evaluates to"
msgstr ""
"\n"
"  -f, --install-from-file=FILE\n"
"                         FILE 내부의 코드가 평가하는 패키지 설치"

#: guix/scripts/package.scm:442
msgid ""
"\n"
"  -r, --remove PACKAGE ...\n"
"                         remove PACKAGEs"
msgstr ""
"\n"
"  -r, --remove 패키지 ...\n"
"                         패키지 제거"

#: guix/scripts/package.scm:445
msgid ""
"\n"
"  -u, --upgrade[=REGEXP] upgrade all the installed packages matching REGEXP"
msgstr ""
"\n"
"  -u, --upgrade[=정규식] 정규식과 일치하는 설치된 모든 패키지 업그레이드"

#: guix/scripts/package.scm:447
msgid ""
"\n"
"  -m, --manifest=FILE    create a new profile generation with the manifest\n"
"                         from FILE"
msgstr ""
"\n"
"  -m, --manifest=파일    파일의 매니페스트를 사용하여 새 프로필 세대 생성"

#: guix/scripts/package.scm:450 guix/scripts/upgrade.scm:41
msgid ""
"\n"
"      --do-not-upgrade[=REGEXP] do not upgrade any packages matching REGEXP"
msgstr ""
"\n"
"      --do-not-upgrade[=정규식] 정규식과 일치하는 패키지를 업그레이드하지 않"
"음"

#: guix/scripts/package.scm:452 guix/scripts/pull.scm:129
msgid ""
"\n"
"      --roll-back        roll back to the previous generation"
msgstr ""
"\n"
"      --roll-back        이전 세대로 롤백"

#: guix/scripts/package.scm:454
msgid ""
"\n"
"      --search-paths[=KIND]\n"
"                         display needed environment variable definitions"
msgstr ""
"\n"
"      --search-paths[=종류]\n"
"                         필요한 환경 변수 정의 표시"

#: guix/scripts/package.scm:457 guix/scripts/pull.scm:124
msgid ""
"\n"
"  -l, --list-generations[=PATTERN]\n"
"                         list generations matching PATTERN"
msgstr ""
"\n"
"  -l, --list-generations[=패턴]\n"
"                         패턴과 일치하는 세대 나열"

#: guix/scripts/package.scm:460 guix/scripts/pull.scm:131
msgid ""
"\n"
"  -d, --delete-generations[=PATTERN]\n"
"                         delete generations matching PATTERN"
msgstr ""
"\n"
"  -d, --delete-generations[=패턴]\n"
"                         패턴과 일치하는 세대 삭제"

#: guix/scripts/package.scm:463 guix/scripts/pull.scm:134
msgid ""
"\n"
"  -S, --switch-generation=PATTERN\n"
"                         switch to a generation matching PATTERN"
msgstr ""
"\n"
"  -S, --switch-generation=패턴\n"
"                         패턴과 일치하는 세대로 전환"

#: guix/scripts/package.scm:466
msgid ""
"\n"
"      --export-manifest  print a manifest for the chosen profile"
msgstr ""
"\n"
"      --export-manifest  선택한 프로필의 매니페스트 출력"

#: guix/scripts/package.scm:468
msgid ""
"\n"
"      --export-channels  print channels for the chosen profile"
msgstr ""
"\n"
"      --export-channels  선택한 프로필의 채널 출력"

#: guix/scripts/package.scm:470 guix/scripts/install.scm:34
#: guix/scripts/remove.scm:33 guix/scripts/upgrade.scm:37
msgid ""
"\n"
"  -p, --profile=PROFILE  use PROFILE instead of the user's default profile"
msgstr ""
"\n"
"  -p, --profile=프로필  사용자의 기본 프로필 대신 프로필 사용"

#: guix/scripts/package.scm:472
msgid ""
"\n"
"      --list-profiles    list the user's profiles"
msgstr ""
"\n"
"      --list-profiles    사용자의 프로필 나열"

#: guix/scripts/package.scm:475
msgid ""
"\n"
"      --allow-collisions do not treat collisions in the profile as an error"
msgstr ""
"\n"
"      --allow-collisions 프로필 내 충돌을 오류로 처리하지 않음"

#: guix/scripts/package.scm:477
msgid ""
"\n"
"      --bootstrap        use the bootstrap Guile to build the profile"
msgstr ""
"\n"
"      --bootstrap        부트스트랩 Guile을 사용하여 프로필 빌드"

#: guix/scripts/package.scm:482
msgid ""
"\n"
"  -s, --search=REGEXP    search in synopsis and description using REGEXP"
msgstr ""
"\n"
"  -s, --search=정규식    정규식을 사용하여 시놉시스 및 설명 검색"

#: guix/scripts/package.scm:484
msgid ""
"\n"
"  -I, --list-installed[=REGEXP]\n"
"                         list installed packages matching REGEXP"
msgstr ""
"\n"
"  -I, --list-installed[=정규식]\n"
"                         정규식과 일치하는 설치된 패키지 나열"

#: guix/scripts/package.scm:487
msgid ""
"\n"
"  -A, --list-available[=REGEXP]\n"
"                         list available packages matching REGEXP"
msgstr ""
"\n"
"  -A, --list-available[=정규식]\n"
"                         정규식과 일치하는 사용 가능한 패키지 나열"

#: guix/scripts/package.scm:490
msgid ""
"\n"
"      --show=PACKAGE     show details about PACKAGE"
msgstr ""
"\n"
"      --show=패키지     패키지에 대한 세부 정보 표시"

#: guix/scripts/package.scm:545
#, scheme-format
msgid "upgrade regexp '~a' looks like a command-line option~%"
