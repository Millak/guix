msgstr "~a: 잘못된 입력 단순화 정책~%"

#: guix/scripts/style.scm:815
msgid "Available styling rules:\n"
msgstr "사용 가능한 스타일링 규칙:\n"

#: guix/scripts/style.scm:816
msgid "- format: Format the given package definition(s)\n"
msgstr "- format: 주어진 패키지 정의를 포맷합니다\n"

#: guix/scripts/style.scm:817
msgid "- inputs: Rewrite package inputs to the “new style”\n"
msgstr "- inputs: 패키지 입력을 “새 스타일”로 고쳐 씁니다\n"

#: guix/scripts/style.scm:818
msgid "- arguments: Rewrite package arguments to G-expressions\n"
msgstr "- arguments: 패키지 인수를 G-expression으로 고쳐 씁니다\n"

#: guix/scripts/style.scm:819
msgid "- git-source: Rewrite source fetch method to Git.\n"
msgstr "- git-source: 소스 가져오기 메서드를 Git으로 고쳐 씁니다.\n"

#: guix/scripts/style.scm:822
msgid ""
"Usage: guix style [OPTION]... [PACKAGE]...\n"
"Update package definitions to the latest style.\n"
msgstr ""
"사용법: guix style [옵션]... [패키지]...\n"
"패키지 정의를 최신 스타일로 업데이트합니다.\n"

#: guix/scripts/style.scm:824
msgid ""
"\n"
"  -S, --styling=RULE     apply RULE, a styling rule"
msgstr ""
"\n"
"  -S, --styling=RULE     스타일 규칙인 RULE을 적용합니다"

#: guix/scripts/style.scm:826
msgid ""
"\n"
"  -l, --list-stylings    display the list of available style rules"
msgstr ""
"\n"
"  -l, --list-stylings    사용 가능한 스타일 규칙 목록을 표시합니다"

#: guix/scripts/style.scm:829
msgid ""
"\n"
"  -n, --dry-run          display files that would be edited but do nothing"
msgstr ""
"\n"
"  -n, --dry-run          편집될 파일들을 표시하되 아무 작업도 수행하지 않습니"
"다"

#: guix/scripts/style.scm:835
msgid ""
"\n"
"      --input-simplification=POLICY\n"
"                         follow POLICY for package input simplification, "
"one\n"
"                         of 'silent', 'safe', or 'always'"
msgstr ""
"\n"
"      --input-simplification=POLICY\n"
"                         패키지 입력 단순화를 위한 POLICY를 따릅니다. 정책"
"은\n"
"                         'silent', 'safe', 'always' 중 하나입니다"

#: guix/scripts/style.scm:840
msgid ""
"\n"
"  -f, --whole-file       format the entire contents of the given file(s)"
msgstr ""
"\n"
"  -f, --whole-file       주어진 파일들의 전체 내용을 포맷합니다"

#: guix/scripts/style.scm:842
msgid ""
"\n"
"  -A, --alphabetical-sort\n"
"                         place the contents in alphabetical order as well"
msgstr ""
"\n"
"  -A, --alphabetical-sort\n"
"                         내용도 알파벳 순서대로 배치합니다"

#: guix/scripts/style.scm:865
msgid "update the style of package definitions"
msgstr "패키지 정의 스타일을 업데이트합니다"

#: guix/scripts/style.scm:885
#, scheme-format
msgid "'--styling' option has no effect in whole-file mode~%"
msgstr "'--styling' 옵션은 전체 파일 모드에서 아무런 영향을 미치지 않습니다~%"

#: guix/scripts/home/import.scm:177
#, scheme-format
msgid ""
";; Below is the list of packages that will show up in your\n"
";; Home profile, under ~/.guix-home/profile.\n"
msgstr ""
";; 아래는 ~/.guix-home/profile 아래에 있는 귀하의 홈 프로파일에\n"
";; 나타날 패키지 목록입니다.\n"

#: guix/scripts/home/import.scm:184
msgid ""
";; Below is the list of Home services.  To search for available\n"
";; services, run 'guix home search KEYWORD' in a terminal.\n"
msgstr ""
";; 아래는 홈 서비스 목록입니다. 사용 가능한 서비스를 검색하려면\n"
";; 터미널에서 'guix home search KEYWORD'를 실행하십시오.\n"

#: guix/scripts/home/import.scm:197
msgid ""
";; This \"home-environment\" file can be passed to 'guix home reconfigure'\n"
";; to reproduce the content of your profile.  This is \"symbolic\": it only\n"
";; specifies package names.  To reproduce the exact same profile, you also\n"
";; need to capture the channels being used, as returned by \"guix "
"describe\".\n"
";; See the \"Replicating Guix\" section in the manual.\n"
msgstr ""
";; 이 \"home-environment\" 파일은 귀하의 프로파일 내용을 재현하기 위해\n"
";; 'guix home reconfigure'로 전달될 수 있습니다. 이것은 \"상징적(symbolic)"
"\"입니다: 오직\n"
";; 패키지 이름만 지정합니다. 똑같은 프로파일을 재현하려면 \"guix "
"describe\"가\n"
";; 반환하는 것과 같이 사용 중인 채널도 캡처해야 합니다.\n"
";; 매뉴얼의 \"Replicating Guix\" 섹션을 참조하십시오.\n"

#: guix/scripts/home.scm:101
msgid ""
"Usage: guix home [OPTION ...] ACTION [ARG ...] [FILE]\n"
"Build the home environment declared in FILE according to ACTION.\n"
"Some ACTIONS support additional ARGS.\n"
msgstr ""
"사용법: guix home [옵션 ...] 작업 [인수 ...] [파일]\n"
"파일에 선언된 홈 환경을 작업에 따라 빌드합니다.\n"
"일부 작업은 추가 인수를 지원합니다.\n"

#: guix/scripts/home.scm:107
msgid "   search             search for existing service types\n"
msgstr "   search             기존 서비스 유형을 검색합니다\n"

#: guix/scripts/home.scm:109
msgid "   edit               edit the definition of an existing service type\n"
msgstr "   edit               기존 서비스 유형의 정의를 편집합니다\n"

#: guix/scripts/home.scm:111
msgid ""
"\n"
"   container          run the home environment configuration in a container\n"
msgstr ""
"\n"
"   container          컨테이너 안에서 홈 환경 구성을 실행합니다\n"

#: guix/scripts/home.scm:113
msgid "   reconfigure        switch to a new home environment configuration\n"
msgstr "   reconfigure        새 홈 환경 구성으로 전환합니다\n"

#: guix/scripts/home.scm:115
msgid ""
"   roll-back          switch to the previous home environment configuration\n"
msgstr "   roll-back          이전 홈 환경 구성으로 전환합니다\n"

#: guix/scripts/home.scm:117
msgid "   describe           describe the current home environment\n"
msgstr "   describe           현재 홈 환경을 설명합니다\n"

#: guix/scripts/home.scm:119
msgid "   list-generations   list the home environment generations\n"
msgstr "   list-generations   홈 환경 세대들을 나열합니다\n"

#: guix/scripts/home.scm:121
msgid ""
"   switch-generation  switch to an existing home environment configuration\n"
msgstr "   switch-generation  기존 홈 환경 구성으로 전환합니다\n"

#: guix/scripts/home.scm:123
msgid "   delete-generations delete old home environment generations\n"
msgstr "   delete-generations 오래된 홈 환경 세대들을 삭제합니다\n"

#: guix/scripts/home.scm:125
msgid ""
"   build              build the home environment without installing "
"anything\n"
msgstr "   build              아무것도 설치하지 않고 홈 환경을 빌드합니다\n"

#: guix/scripts/home.scm:127
msgid ""
"   import             generates a home environment definition from dotfiles\n"
msgstr ""
"   import             설정 파일(dotfiles)로부터 홈 환경 정의를 생성합니다\n"

#: guix/scripts/home.scm:129
msgid "   extension-graph    emit the service extension graph\n"
msgstr "   extension-graph    서비스 확장 그래프를 출력합니다\n"

#: guix/scripts/home.scm:131
msgid "   shepherd-graph     emit the graph of shepherd services\n"
msgstr "   shepherd-graph     shepherd 서비스 그래프를 출력합니다\n"

#: guix/scripts/home.scm:135
msgid ""
"\n"
"  -e, --expression=EXPR  consider the home-environment EXPR evaluates to\n"
"                         instead of reading FILE, when applicable"
msgstr ""
"\n"
"  -e, --expression=EXPR  해당하는 경우, FILE을 읽는 대신 EXPR이 평가하는\n"
"                         홈 환경을 고려합니다"

#: guix/scripts/home.scm:157
msgid ""
"\n"
"  -I, --list-installed[=REGEXP]\n"
"                         for 'describe' or 'list-generations', list "
"installed\n"
"                         packages matching REGEXP"
msgstr ""
"\n"
"  -I, --list-installed[=REGEXP]\n"
"                         'describe' 또는 'list-generations'의 경우, REGEXP에 "
"일치하는\n"
"                         설치된 패키지들을 나열합니다"

#: guix/scripts/home.scm:517
#, scheme-format
msgid "'~a' does not contain a home environment for user '~a'~%"
msgstr "'~0@*~a'에 사용자 '~1@*~a'의 홈 환경이 포함되어 있지 않습니다~%"

#: guix/scripts/home.scm:520
#, scheme-format
msgid "'~a' does not have a service of type 'guix-home-service-type'~%"
msgstr "'~a'에 'guix-home-service-type' 형식의 서비스가 없습니다~%"

#: guix/scripts/home.scm:523
#, scheme-format
msgid "'~a' does not return a home environment~%"
msgstr "'~a'(이)가 홈 환경을 반환하지 않습니다~%"

#: guix/scripts/home.scm:618
#, scheme-format
msgid "'~a' populated with all the Home configuration files~%"
msgstr "'~a'에 모든 홈 구성 파일들이 채워졌습니다~%"

#: guix/scripts/home.scm:620
#, scheme-format
msgid ""
"Run @command{guix home reconfigure ~a/home-configuration.scm} to "
"effectively\n"
"deploy the home environment described by these files.\n"
msgstr ""
"이 파일들이 설명하는 홈 환경을 효과적으로 배포하려면\n"
"@command{guix home reconfigure ~a/home-configuration.scm}을 실행하십시오.\n"

#: guix/scripts/home.scm:628
#, scheme-format
msgid "no home environment generation, nothing to describe~%"
msgstr "홈 환경 세대가 없어 설명할 내용이 없습니다~%"

#: guix/scripts/home.scm:662
msgid "build and deploy home environments"
msgstr "홈 환경을 빌드하고 배포합니다"

#: guix/scripts/home.scm:699
#, scheme-format
msgid "guix home: missing command name~%"
msgstr "guix home: 명령 이름이 누락되었습니다~%"

#: guix/scripts/home.scm:701
#, scheme-format
msgid "Try 'guix home --help' for more information.~%"
msgstr "자세한 정보는 'guix home --help'를 실행해 보십시오.~%"

#: guix/scripts/home.scm:731
#, scheme-format
msgid "~a: extraneous command~%"
msgstr "~a: 관련 없는 명령입니다~%"

#: guix/scripts/home.scm:901
#, scheme-format
msgid "cannot switch to home environment generation '~a'~%"
msgstr "홈 환경 세대 '~a'(으)로 전환할 수 없습니다~%"

#: guix/scripts/time-machine.scm:55
msgid ""
"Usage: guix time-machine [OPTION] [-- COMMAND ARGS...]\n"
"Execute COMMAND ARGS... in a different version of Guix.\n"
"\n"
"If COMMAND is not provided, print path to the time-machine profile.\n"
msgstr ""
"사용법: guix time-machine [옵션] [-- 명령 인수...]\n"
"다른 버전의 Guix에서 명령 인수...를 실행합니다.\n"
"\n"
"명령이 제공되지 않으면 time-machine 프로파일의 경로를 출력합니다.\n"

#: guix/scripts/time-machine.scm:68
msgid ""
"\n"
"      --url=URL          use the Git repository at URL"
msgstr ""
"\n"
"      --url=URL          URL에 있는 Git 저장소를 사용합니다"

#: guix/scripts/time-machine.scm:70
msgid ""
"\n"
"      --commit=COMMIT    use the specified COMMIT"
msgstr ""
"\n"
"      --commit=COMMIT    지정된 COMMIT을 사용합니다"

#: guix/scripts/time-machine.scm:72
msgid ""
"\n"
"      --branch=BRANCH    use the tip of the specified BRANCH"
msgstr ""
"\n"
"      --branch=BRANCH    지정된 BRANCH의 끝을 사용합니다"

#: guix/scripts/time-machine.scm:201
#, scheme-format
msgid "cannot travel past commit `~a' from May 1st, 2019"
msgstr "2019년 5월 1일의 커밋 `~a' 이전으로 거슬러 올라갈 수 없습니다"

#: guix/scripts/time-machine.scm:211
msgid "run commands from a different revision"
msgstr "다른 리비전에서 명령을 실행합니다"

#: guix/scripts/import.scm:54 guix/scripts/import/crate.scm:82
#, scheme-format
msgid "file '~a' does not exist~%"
msgstr "파일 '~a'가 존재하지 않습니다~%"

#: guix/scripts/import.scm:75
msgid ""
"Usage: guix import IMPORTER ARGS ...\n"
"Run IMPORTER with ARGS.\n"
msgstr ""
"사용법: guix import 가져오기도구 인수 ...\n"
"가져오기도구를 인수와 함께 실행합니다.\n"

#: guix/scripts/import.scm:78
msgid "IMPORTER must be one of the importers listed below:\n"
msgstr "가져오기도구는 아래 나열된 가져오기 도구 중 하나여야 합니다:\n"

#: guix/scripts/import.scm:83
msgid ""
"\n"
"  -i, --insert=FILE      insert packages into FILE alphabetically"
msgstr ""
"\n"
"  -i, --insert=FILE      패키지들을 FILE에 알파벳 순으로 삽입합니다"

#: guix/scripts/import.scm:112
#, scheme-format
msgid "'~a' import failed~%"
msgstr "'~a' 가져오기에 실패했습니다~%"

#: guix/scripts/import.scm:114
#, scheme-format
msgid "~a: invalid importer~%"
msgstr "~a: 잘못된 가져오기도구입니다~%"

#: guix/scripts/import.scm:121
msgid "import a package definition from an external repository"
msgstr "외부 저장소에서 패키지 정의를 가져옵니다"

#: guix/scripts/import.scm:137
#, scheme-format
msgid "guix import: missing importer name~%"
msgstr "guix import: 가져오기도구 이름이 누락되었습니다~%"

#: guix/import/utils.scm:295
#, scheme-format
msgid "failed to download Git repository ~a: ~a~%"
msgstr "Git 저장소 ~a 다운로드 실패: ~a~%"

#: guix/import/utils.scm:497
msgid ""
"This package lacks a description.  Run \"info '(guix) Synopses and "
"Descriptions'\" for more information."
msgstr ""
"이 패키지는 설명이 부족합니다. 자세한 정보는 \"info '(guix) Synopses and "
"Descriptions'\"를 실행하십시오."

#: guix/import/utils.scm:581
msgid ""
"This package lacks a synopsis.  Run \"info '(guix) Synopses and "
"Descriptions'\" for more information."
msgstr ""
"이 패키지는 시놉시스(요약)가 부족합니다. 자세한 정보는 \"info '(guix) "
"Synopses and Descriptions'\"를 실행하십시오."

#: guix/import/composer.scm:236 guix/import/stackage.scm:158
#, scheme-format
msgid "failed to parse ~a~%"
msgstr "~a 구문 분석 실패~%"

