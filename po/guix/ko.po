"Usage: guix gc [OPTION]... PATHS...\n"
"Invoke the garbage collector.\n"
msgstr ""
"사용법: guix gc [옵션]... 경로...\n"
"가비지 컬렉터를 호출합니다.\n"

#: guix/scripts/gc.scm:54
msgid ""
"\n"
"  -C, --collect-garbage[=MIN]\n"
"                         collect at least MIN bytes of garbage"
msgstr ""
"\n"
"  -C, --collect-garbage[=최소]\n"
"                         최소 바이트의 가비지 수집"

#: guix/scripts/gc.scm:57
msgid ""
"\n"
"  -F, --free-space=FREE  attempt to reach FREE available space in the store"
msgstr ""
"\n"
"  -F, --free-space=공간  저장소의 가용한 공간이 되도록 시도"

#: guix/scripts/gc.scm:59
msgid ""
"\n"
"  -d, --delete-generations[=PATTERN]\n"
"                         delete profile generations matching PATTERN"
msgstr ""
"\n"
"  -d, --delete-generations[=PATTERN]\n"
"                         PATTERN에 일치하는 프로필 세대를 삭제합니다"

#: guix/scripts/gc.scm:62
msgid ""
"\n"
"  -D, --delete           attempt to delete PATHS"
msgstr ""
"\n"
"  -D, --delete           PATHS의 삭제를 시도합니다"

#: guix/scripts/gc.scm:64
msgid ""
"\n"
"      --list-roots       list the user's garbage collector roots"
msgstr ""
"\n"
"      --list-roots       사용자의 가비지 컬렉터 루트 목록을 보여줍니다"

#: guix/scripts/gc.scm:66
msgid ""
"\n"
"      --list-busy        list store items used by running processes"
msgstr ""
"\n"
"      --list-busy        실행 중인 프로세스가 사용하는 저장소 항목의 목록을 "
"보여줍니다"

#: guix/scripts/gc.scm:68
msgid ""
"\n"
"      --optimize         optimize the store by deduplicating identical files"
msgstr ""
"\n"
"      --optimize         동일한 파일을 중복 제거하여 저장소를 최적화합니다"

#: guix/scripts/gc.scm:70
msgid ""
"\n"
"      --list-dead        list dead paths"
msgstr ""
"\n"
"      --list-dead        사용되지 않는(dead) 경로 목록을 보여줍니다"

#: guix/scripts/gc.scm:72
msgid ""
"\n"
"      --list-live        list live paths"
msgstr ""
"\n"
"      --list-live        사용 중인(live) 경로 목록을 보여줍니다"

#: guix/scripts/gc.scm:75
msgid ""
"\n"
"      --references       list the references of PATHS"
msgstr ""
"\n"
"      --references       PATHS의 참조 목록을 보여줍니다"

#: guix/scripts/gc.scm:77
msgid ""
"\n"
"  -R, --requisites       list the requisites of PATHS"
msgstr ""
"\n"
"  -R, --requisites       PATHS의 필요 조건 목록을 보여줍니다"

#: guix/scripts/gc.scm:79
msgid ""
"\n"
"      --referrers        list the referrers of PATHS"
msgstr ""
"\n"
"      --referrers        PATHS를 참조하는 항목 목록을 보여줍니다"

#: guix/scripts/gc.scm:81
msgid ""
"\n"
"      --derivers         list the derivers of PATHS"
msgstr ""
"\n"
"      --derivers         PATHS의 파생 항목 목록을 보여줍니다"

#: guix/scripts/gc.scm:84
msgid ""
"\n"
"      --verify[=OPTS]    verify the integrity of the store; OPTS is a\n"
"                         comma-separated combination of 'repair' and\n"
"                         'contents'"
msgstr ""
"\n"
"      --verify[=OPTS]    저장소의 무결성을 검증합니다. OPTS는 쉼표로\n"
"                         구분된 'repair'와 'contents'의 조합입니다"

#: guix/scripts/gc.scm:88
msgid ""
"\n"
"      --list-failures    list cached build failures"
msgstr ""
"\n"
"      --list-failures    캐시된 빌드 실패 목록을 보여줍니다"

#: guix/scripts/gc.scm:90
msgid ""
"\n"
"      --clear-failures   remove PATHS from the set of cached failures"
msgstr ""
"\n"
"      --clear-failures   캐시된 빌드 실패 집합에서 PATHS를 제거합니다"

#: guix/scripts/gc.scm:93
msgid ""
"\n"
"      --vacuum-database  repack the sqlite database tracking the store\n"
"                         using less space"
msgstr ""
"\n"
"      --vacuum-database  저장소를 추적하는 sqlite 데이터베이스를\n"
"                         더 적은 공간을 사용하도록 다시 패킹합니다"

#: guix/scripts/gc.scm:108
#, scheme-format
msgid "~a: invalid '--verify' option~%"
msgstr "~a: 잘못된 '--verify' 옵션~%"

#: guix/scripts/gc.scm:146
#, scheme-format
msgid "vacuuming the database can only be used by root~%"
msgstr "데이터베이스 비우기는 root만 사용할 수 있습니다~%"

#: guix/scripts/gc.scm:159
#, scheme-format
msgid "invalid amount of storage: ~a~%"
msgstr "잘못된 저장 공간 크기: ~a~%"

#: guix/scripts/gc.scm:173
#, scheme-format
msgid "'-d' as an alias for '--delete' is deprecated; use '-D'~%"
msgstr "'--delete'의 별칭으로서 '-d'는 폐지되었습니다. '-D'를 사용하십시오~%"

#: guix/scripts/gc.scm:180
#, scheme-format
msgid "~s does not denote a duration~%"
msgstr "~s은(는) 기간을 나타내지 않습니다~%"

#: guix/scripts/gc.scm:241
msgid "invoke the garbage collector"
msgstr "가비지 컬렉터를 호출합니다"

#: guix/scripts/gc.scm:268
#, scheme-format
msgid "already ~a available on ~a, nothing to do~%"
msgstr "이미 ~0@*~a에서 ~1@*~a를 사용할 수 있으므로, 실행할 작업이 없습니다~%"

#: guix/scripts/gc.scm:271
#, scheme-format
msgid "freeing ~a~%"
msgstr "~a 공간을 확보하는 중~%"

#: guix/scripts/gc.scm:310
#, scheme-format
msgid "extraneous arguments: ~{~a ~}~%"
msgstr "남는 인수: ~{~a ~}~%"

#: guix/scripts/gc.scm:336 guix/scripts/gc.scm:339
#, scheme-format
msgid "freed ~a~%"
msgstr "~a 공간을 확보했습니다~%"

#: guix/scripts/git.scm:26
msgid ""
"Usage: guix git COMMAND ARGS...\n"
"Operate on Git repositories.\n"
msgstr ""
"사용법: guix git 명령 인수...\n"
"Git 저장소를 조작합니다.\n"

#: guix/scripts/git.scm:29 guix/scripts/system.scm:981
#: guix/scripts/container.scm:30 guix/scripts/home.scm:105
msgid "The valid values for ACTION are:\n"
msgstr "ACTION에 유효한 값은 다음과 같습니다:\n"

#: guix/scripts/git.scm:31
msgid "   authenticate    verify commit signatures and authorizations\n"
msgstr "   authenticate    커밋 서명 및 권한을 검증합니다\n"

#: guix/scripts/git.scm:51
msgid "operate on Git repositories"
msgstr "Git 저장소를 조작합니다"

#: guix/scripts/git.scm:57
#, scheme-format
msgid "guix git: missing sub-command~%"
msgstr "guix git: 하위 명령이 누락되었습니다~%"

#: guix/scripts/git.scm:67
#, scheme-format
msgid "guix git: invalid sub-command~%"
msgstr "guix git: 잘못된 하위 명령입니다~%"

#: guix/scripts/git/authenticate.scm:121
#, scheme-format
msgid "unknown introductory commit and signer~%"
msgstr "알 수 없는 최초 커밋 및 서명자입니다~%"

#: guix/scripts/git/authenticate.scm:147
#, scheme-format
msgid "introduction and keyring recorded in repository configuration file~%"
msgstr "최초 커밋 및 키링이 저장소 설정 파일에 기록되었습니다~%"

#: guix/scripts/git/authenticate.scm:185
#, scheme-format
msgid "not overriding pre-existing hooks '~a' and '~a'~%"
msgstr "기존 훅 '~a' 및 '~a'을(를) 덮어쓰지 않습니다~%"

#: guix/scripts/git/authenticate.scm:187
msgid ""
"Consider running @command{guix git authenticate}\n"
"from your pre-push and post-merge hooks so your repository is automatically\n"
"authenticated before you push and when you pull updates."
msgstr ""
"저장소를 푸시하기 전이나 업데이트를 풀할 때 자동으로 인증되도록\n"
"pre-push 및 post-merge 훅에서 @command{guix git authenticate}을(를)\n"
"실행하는 것을 고려해 보십시오."

#: guix/scripts/git/authenticate.scm:201
#, scheme-format
msgid "installed hooks '~a' and '~a'~%"
msgstr "'~a' 및 '~a' 후크가 설치됨~%"

#: guix/scripts/git/authenticate.scm:234
#, scheme-format
msgid "upgrading hook '~a'~%"
msgstr "훅 '~a' 업그레이드 중~%"

#: guix/scripts/git/authenticate.scm:251
#, scheme-format
msgid "Signing statistics:~%"
msgstr "서명 통계:~%"

#: guix/scripts/git/authenticate.scm:264
msgid ""
"Usage: guix git authenticate COMMIT SIGNER [OPTIONS...]\n"
"Authenticate the given Git checkout using COMMIT/SIGNER as its "
"introduction.\n"
msgstr ""
"사용법: guix git authenticate 커밋 서명자 [옵션...]\n"
"COMMIT/SIGNER를 최초 커밋으로 사용하여 지정한 Git 체크아웃을 인증합니다.\n"

#: guix/scripts/git/authenticate.scm:266
msgid ""
"\n"
"  -r, --repository=DIRECTORY\n"
"                         open the Git repository at DIRECTORY"
msgstr ""
"\n"
"  -r, --repository=DIRECTORY\n"
"                         DIRECTORY에 있는 Git 저장소를 엽니다"

#: guix/scripts/git/authenticate.scm:269
msgid ""
"\n"
"  -k, --keyring=REFERENCE\n"
"                         load keyring from REFERENCE, a Git branch"
msgstr ""
"\n"
"  -k, --keyring=REFERENCE\n"
"                         Git 브랜치인 REFERENCE에서 키링을 로드합니다"

#: guix/scripts/git/authenticate.scm:272
msgid ""
"\n"
"      --end=COMMIT       authenticate revisions up to COMMIT"
msgstr ""
"\n"
"      --end=COMMIT       COMMIT까지의 리비전을 인증합니다"

#: guix/scripts/git/authenticate.scm:274
msgid ""
"\n"
"      --stats            display commit signing statistics upon completion"
msgstr ""
"\n"
"      --stats            완료 시 커밋 서명 통계를 표시합니다"

#: guix/scripts/git/authenticate.scm:276
msgid ""
"\n"
"      --cache-key=KEY    cache authenticated commits under KEY"
msgstr ""
"\n"
"      --cache-key=KEY    KEY 아래에 인증된 커밋을 캐시합니다"

#: guix/scripts/git/authenticate.scm:278
msgid ""
"\n"
"      --historical-authorizations=FILE\n"
"                         read historical authorizations from FILE"
msgstr ""
"\n"
"      --historical-authorizations=FILE\n"
"                         FILE에서 이전 권한 부여 목록을 읽습니다"

#: guix/scripts/git/authenticate.scm:312
#, scheme-format
msgid "~a: invalid OpenPGP fingerprint~%"
msgstr "~a: 잘못된 OpenPGP 지문~%"

#: guix/scripts/git/authenticate.scm:315
#, scheme-format
msgid "~a: wrong length for OpenPGP fingerprint~%"
msgstr "~a: OpenPGP 지문의 길이가 잘못되었습니다~%"

#: guix/scripts/git/authenticate.scm:320
msgid "Authenticating commits ~a to ~a (~h new commits)...~%"
msgstr "커밋 ~a부터 ~a까지 인증하는 중 (~h개의 새 커밋)...~%"

#: guix/scripts/git/authenticate.scm:331
#, scheme-format
msgid "wrong number of arguments; expected COMMIT and SIGNER~%"
msgstr "인수 개수가 잘못되었습니다. COMMIT과 SIGNER가 필요합니다~%"

#: guix/scripts/git/authenticate.scm:365
#, scheme-format
msgid "current branch '~a' is the keyring branch; doing nothing~%"
msgstr "현재 브랜치 '~a'은(는) 키링 브랜치이므로, 아무 작업도 하지 않습니다~%"

#: guix/scripts/git/authenticate.scm:388
#, scheme-format
msgid "successfully authenticated commit ~a~%"
msgstr "커밋 ~a을(를) 성공적으로 인증했습니다~%"

#: guix/scripts/hash.scm:79
msgid ""
"Usage: guix hash [OPTION] FILE\n"
"Return the cryptographic hash of FILE.\n"
msgstr ""
"사용법: guix hash [옵션] 파일\n"
"파일의 암호화 해시를 반환합니다.\n"

#: guix/scripts/hash.scm:85
msgid ""
"\n"
"  -x, --exclude-vcs      exclude version control directories"
msgstr ""
"\n"
"  -x, --exclude-vcs      버전 관리 디렉터리를 제외합니다"

#: guix/scripts/hash.scm:91
msgid ""
"\n"
"  -S, --serializer=TYPE  compute the hash on FILE according to TYPE "
"serialization"
msgstr ""
"\n"
"  -S, --serializer=TYPE  TYPE 직렬화 방식에 따라 파일의 해시를 계산합니다"

#: guix/scripts/hash.scm:134
#, scheme-format
msgid "'--recursive' is deprecated, use '--serializer=nar' instead~%"
msgstr ""
"'--recursive'는 폐지되었습니다. 대신 '--serializer=nar'를 사용하십시오~%"

#: guix/scripts/hash.scm:149
#, scheme-format
msgid "unsupported serializer type: ~a~%"
msgstr "지원하지 않는 직렬화 형식입니다: ~a~%"

#: guix/scripts/hash.scm:170
msgid "compute the cryptographic hash of a file"
msgstr "파일의 암호화 해시를 계산합니다"

#: guix/scripts/hash.scm:198
#, scheme-format
msgid "~a ~a~%"
msgstr "~a ~a~%"

#: guix/scripts/hash.scm:207
#, scheme-format
msgid "no arguments specified~%"
msgstr "인수를 지정하지 않았습니다~%"

#: guix/scripts/pull.scm:90
msgid ""
"Usage: guix pull [OPTION]...\n"
"Download and deploy the latest version of Guix.\n"
msgstr ""
"사용법: guix pull [옵션]...\n"
"최신 버전의 Guix를 다운로드하고 배포합니다.\n"

#: guix/scripts/pull.scm:92 guix/scripts/time-machine.scm:59
msgid ""
"\n"
"  -C, --channels=FILE    deploy the channels defined in FILE"
msgstr ""
"\n"
"  -C, --channels=FILE    FILE에 정의된 채널을 배포합니다"

#: guix/scripts/pull.scm:94 guix/scripts/time-machine.scm:61
msgid ""
"\n"
"  -q, --no-channel-files\n"
"                         inhibit loading of user and system 'channels.scm'"
msgstr ""
"\n"
"  -q, --no-channel-files\n"
"                         사용자 및 시스템 'channels.scm' 로드를 방지합니다"

#: guix/scripts/pull.scm:97 guix/scripts/time-machine.scm:64
msgid ""
"\n"
"  -e, --select=CHANNEL   select CHANNEL to update"
msgstr ""
"\n"
"  -e, --select=CHANNEL   업데이트할 CHANNEL을 선택합니다"

#: guix/scripts/pull.scm:99 guix/scripts/time-machine.scm:66
msgid ""
"\n"
"  -x, --exclude=CHANNEL  exclude CHANNEL from being updated"
msgstr ""
"\n"
"  -x, --exclude=CHANNEL  업데이트에서 CHANNEL을 제외합니다"

#: guix/scripts/pull.scm:101
msgid ""
"\n"
"      --url=URL          download \"guix\" channel from the Git repository "
"at URL"
msgstr ""
"\n"
"      --url=URL          URL에 있는 Git 저장소에서 \"guix\" 채널을 다운로드합"
"니다"

#: guix/scripts/pull.scm:103
msgid ""
"\n"
"      --commit=COMMIT    download the specified \"guix\" channel COMMIT"
msgstr ""
"\n"
"      --commit=COMMIT    지정한 \"guix\" 채널 COMMIT을 다운로드합니다"

#: guix/scripts/pull.scm:105
msgid ""
"\n"
"      --branch=BRANCH    download the tip of the specified \"guix\" channel "
"BRANCH"
msgstr ""
"\n"
"      --branch=BRANCH    지정한 \"guix\" 채널 BRANCH의 최신(tip)을 다운로드합"
"니다"

#: guix/scripts/pull.scm:107
msgid ""
"\n"
"      --allow-downgrades allow downgrades to earlier channel revisions"
msgstr ""
"\n"
"      --allow-downgrades 이전 채널 리비전으로의 다운그레이드를 허용합니다"

#: guix/scripts/pull.scm:109 guix/scripts/time-machine.scm:74
msgid ""
"\n"
"      --disable-authentication\n"
"                         disable channel authentication"
msgstr ""
"\n"
"      --disable-authentication\n"
"                         채널 인증을 비활성화합니다"

#: guix/scripts/pull.scm:112 guix/scripts/time-machine.scm:77
msgid ""
"\n"
"      --allow-untrusted-channels[=yes|no]\n"
"                         whether to allow untrusted channels (default: yes\n"
"                         for local channel files, no otherwise)"
msgstr ""
"\n"
"      --allow-untrusted-channels[=yes|no]\n"
"                         신뢰할 수 없는 채널 허용 여부 (기본값: 로컬 채널\n"
"                         파일은 yes, 그렇지 않으면 no)"

#: guix/scripts/pull.scm:116 guix/scripts/time-machine.scm:81
msgid ""
"\n"
"      --unsafe-channel-evaluation\n"
"                         evaluate channels file with the full user authority"
msgstr ""
"\n"
"      --unsafe-channel-evaluation\n"
"                         사용자 전체 권한으로 채널 파일을 평가합니다"

#: guix/scripts/pull.scm:119 guix/scripts/time-machine.scm:84
msgid ""
"\n"
"      --no-check-certificate\n"
"                         do not validate the certificate of HTTPS servers"
msgstr ""
"\n"
"      --no-check-certificate\n"
"                         HTTPS 서버의 인증서를 검증하지 않습니다"

#: guix/scripts/pull.scm:122
msgid ""
"\n"
"  -N, --news             display news compared to the previous generation"
msgstr ""
"\n"
"  -N, --news             이전 세대와 비교한 새 소식을 표시합니다"

#: guix/scripts/pull.scm:127
msgid ""
"\n"
"      --details          show details when listing generations"
msgstr ""
"\n"
"      --details          세대 목록을 표시할 때 상세 정보를 보여줍니다"

#: guix/scripts/pull.scm:137
#, scheme-format
msgid ""
"\n"
"  -p, --profile=PROFILE  use PROFILE instead of ~/.config/guix/current"
msgstr ""
"\n"
"  -p, --profile=PROFILE  ~/.config/guix/current 대신 PROFILE을 사용합니다"

#: guix/scripts/pull.scm:141
msgid ""
"\n"
"      --bootstrap        use the bootstrap Guile to build the new Guix"
msgstr ""
"\n"
"      --bootstrap        새 Guix 빌드에 부트스트랩 Guile을 사용합니다"

#: guix/scripts/pull.scm:261 guix/scripts/system/reconfigure.scm:394
#, scheme-format
msgid "rolling back channel '~a' from ~a to ~a~%"
msgstr "채널 '~a'을(를) ~a에서 ~a(으)로 롤백하는 중~%"

#: guix/scripts/pull.scm:264 guix/scripts/system/reconfigure.scm:397
#, scheme-format
msgid "moving channel '~a' from ~a to unrelated commit ~a~%"
msgstr "채널 '~a'을(를) ~a에서 관련 없는 커밋 ~a(으)로 이동하는 중~%"

#: guix/scripts/pull.scm:293
msgid "New in this revision:\n"
msgstr "이 리비전에서 새로 추가된 항목:\n"

#. TRANSLATORS: This describes a "channel"; the first placeholder is
#. the channel name (e.g., "guix") and the second placeholder is its
#. URL.
#: guix/scripts/pull.scm:302
#, scheme-format
msgid "    ~a at ~a~%"
msgstr "    ~a (~a)~%"

#: guix/scripts/pull.scm:341
#, scheme-format
msgid "    commit ~a~%"
msgstr "    커밋 ~a~%"

#: guix/scripts/pull.scm:379
#, scheme-format
msgid "News for channel '~a'~%"
msgstr "채널 '~a' 새 소식~%"

#: guix/scripts/pull.scm:406
#, scheme-format
msgid "  ~a new channel:~%"
msgid_plural "  ~a new channels:~%"
msgstr[0] "  ~a 새로운 채널:~%"

#: guix/scripts/pull.scm:416
#, scheme-format
msgid "  ~a channel removed:~%"
msgid_plural "  ~a channels removed:~%"
msgstr[0] "  ~a 채널 삭제됨:~%"

#: guix/scripts/pull.scm:480
#, scheme-format
msgid "no channel news since generation ~a~%"
msgstr "세대 ~a 이후로 채널 새 소식이 없습니다~%"

#: guix/scripts/pull.scm:481
msgid ""
"Run @command{guix pull -l} to view the\n"
"news for earlier generations."
msgstr ""
"이전 세대의 새 소식을 보려면\n"
"@command{guix pull -l}을(를) 실행하십시오."

#: guix/scripts/pull.scm:483
#, scheme-format
msgid "profile ~a does not have a previous generation~%"
msgstr "프로필 ~a에 이전 세대가 없습니다~%"

#: guix/scripts/pull.scm:509
msgid "Run @command{guix pull --news} to read all the news."
msgstr "@command{guix pull --news}을(를) 실행하여 모든 소식을 읽으십시오."

#: guix/scripts/pull.scm:517
#, scheme-format
msgid ""
"After setting @code{PATH}, run\n"
"@command{hash guix} to make sure your shell refers to @file{~a}."
msgstr ""
"@code{PATH}를 설정한 후, 쉘이 @file{~a}을(를) 가리키도록\n"
"@command{hash guix}을(를) 실행하십시오."

#: guix/scripts/pull.scm:562
#, scheme-format
