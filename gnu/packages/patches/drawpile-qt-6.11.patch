Fix compilation with Qt 6.11.

Pass an integer to QString::arg instead of relying on QFlags conversion.
The explicit cast also works with Qt 5. Upstream addresses this with its
COMPAT_FLAGS_ARG helper in commit:
https://github.com/drawpile/Drawpile/commit/c4f69f79b1cb0d25e68b49e807ce6773ddb9dd3c

Include QTest directly instead of the QtTest module umbrella, which pulls
in all of QtCore and triggers a GCC 14 template substitution crash in
Qt 6.11's QRangeModel. Tests do not use QRangeModel.

Upstream status: Partial backport; test include changes not submitted.

--- a/src/desktop/widgets/tablettest.cpp
+++ b/src/desktop/widgets/tablettest.cpp
@@ -66,7 +66,7 @@
 	emit eventReport(QString("Mouse move X=%1 Y=%2 B=%3")
 						 .arg(mousePos.x())
 						 .arg(mousePos.y())
-						 .arg(e->buttons()));
+						 .arg(static_cast<int>(e->buttons())));
 	m_mousePath << e->pos();
 	update();
 }
@@ -118,7 +118,7 @@
 	msg += QString(" X=%1 Y=%2 B=%3 P=%4% XT=%5° YT=%6° R=%7° %8")
 			   .arg(posF.x(), 0, 'f', 2)
 			   .arg(posF.y(), 0, 'f', 2)
-			   .arg(e->buttons())
+			   .arg(static_cast<int>(e->buttons()))
 			   .arg(e->pressure() * 100, 0, 'f', 1)
 			   .arg(e->xTilt())
 			   .arg(e->yTilt())
