Keep assertions enabled in the UPower integration test.  The test uses
assertions for calls with side effects, so compiling it with NDEBUG skips
required setup and eventually dereferences an empty vector.

diff --git a/meson.build b/meson.build
index 6b4c20b..cd8aca5 100644
--- a/meson.build
+++ b/meson.build
@@ -1229,6 +1229,7 @@ if build_tests
   upower_integration_exe = executable('upower_charge_limit_integration_test',
     sources: files('tests/upower_charge_limit_integration_test.cpp'),
     dependencies: noctalia_core_dep,
+    override_options: ['b_ndebug=false'],
   )
   dbus_run_session = find_program('dbus-run-session', required: false)
   if dbus_run_session.found()
