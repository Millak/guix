Adapted from https://github.com/NixOS/nixpkgs/blob/nixos-unstable/pkgs/by-name/gn/gnustep-make/fixup-paths.patch

Index: gnustep-make-2.9.3/GNUstep.csh.in
===================================================================
--- gnustep-make-2.9.3.orig/GNUstep.csh.in
+++ gnustep-make-2.9.3/GNUstep.csh.in
@@ -133,6 +133,10 @@ if ( ! ${?GNUSTEP_MAKEFILES} ) then
   setenv GNUSTEP_MAKEFILES "@GNUSTEP_MAKEFILES@"
 endif
 
+if ( ! ${?GUIX_GNUSTEP_MAKEFILES_ADDITIONAL} ) then
+  setenv GUIX_GNUSTEP_MAKEFILES_ADDITIONAL "@GUIX_GNUSTEP_MAKEFILES_ADDITIONAL@"
+endif
+
 if ( "${GNUSTEP_MAKE_STRICT_V2_MODE}" == "yes" ) then
   unsetenv GNUSTEP_USER_DIR
   unsetenv GNUSTEP_USER_ROOT
Index: gnustep-make-2.9.3/common.make
===================================================================
--- gnustep-make-2.9.3.orig/common.make
+++ gnustep-make-2.9.3/common.make
@@ -204,7 +204,9 @@ include $(GNUSTEP_LOCAL_ADDITIONAL_MAKEF
 endif
 # Then include makefiles with flags/config options installed by the 
 # libraries themselves
--include $(GNUSTEP_MAKEFILES)/Additional/*.make
+ifneq ($(GUIX_GNUSTEP_MAKEFILES_ADDITIONAL),)
+include $(subst :, ,$(GUIX_GNUSTEP_MAKEFILES_ADDITIONAL))
+endif
 
 #
