Index: gnustep-make-2.9.3/gnustep-config.in
===================================================================
--- gnustep-make-2.9.3.orig/gnustep-config.in
+++ gnustep-make-2.9.3/gnustep-config.in
@@ -74,6 +74,7 @@ if [ "$1" = "--help" ]; then
     echo "    --variable=DEBUGGER"
     echo "    --variable=GNUMAKE"
     echo "    --variable=GNUSTEP_MAKEFILES"
+    echo "    --variable=GUIX_GNUSTEP_MAKEFILES_ADDITIONAL"
     echo "    --variable=GNUSTEP_USER_DEFAULTS_DIR"
     echo "    --variable=GNUSTEP_HOST"
     echo "    --variable=GNUSTEP_HOST_CPU"
@@ -169,6 +170,8 @@ fi
 
 export GNUSTEP_MAKEFILES
 
+export GUIX_GNUSTEP_MAKEFILES_ADDITIONAL
+
 #
 # If all they want to know is GNUSTEP_MAKEFILES or anything that
 # we can compute only using GNUSTEP_MAKEFILES, we can print it out
@@ -192,6 +195,8 @@ case "$1" in
               exit 0;;
   --variable=GNUSTEP_MAKEFILES) echo "$GNUSTEP_MAKEFILES"
               exit 0;;
+  --variable=GUIX_GNUSTEP_MAKEFILES_ADDITIONAL) echo "$GUIX_GNUSTEP_MAKEFILES_ADDITIONAL"
+              exit 0;;
   --variable=GNUMAKE) echo "@GNUMAKE@"
               exit 0;;
   --debug-flags) @GNUMAKE@ --no-print-directory -s -f "$GNUSTEP_MAKEFILES/empty.make" print-gnustep-make-objc-flags quiet=yes debug=yes 2>/dev/null
Index: gnustep-make-2.9.3/library-combo.make
===================================================================
--- gnustep-make-2.9.3.orig/library-combo.make
+++ gnustep-make-2.9.3/library-combo.make
@@ -85,7 +85,7 @@ endif
 #
 # Third-party foundations not using make package
 # Our own foundation will install a base.make file into 
-# $GNUSTEP_MAKEFILES/Additional/ to set the needed flags
+# $GUIX_GNUSTEP_MAKEFILES_ADDITIONAL to set the needed flags
 #
 ifeq ($(FOUNDATION_LIB), nx)
   # -framework Foundation is used both to find headers, and to link
@@ -109,7 +109,7 @@ endif
 
 #
 # FIXME - Ask Helge to move this inside his libFoundation, and have 
-# it installed as a $(GNUSTEP_MAKEFILES)/Additional/libFoundation.make
+# it installed as a $(GUIX_GNUSTEP_MAKEFILES_ADDITIONAL)/libFoundation.make
 #
 ifeq ($(FOUNDATION_LIB), fd)
   -include $(GNUSTEP_MAKEFILES)/libFoundation.make
@@ -133,7 +133,7 @@ GUI_LDFLAGS =
 GUI_LIBS = 
 #
 # Third-party GUI libraries - our own sets its flags into 
-# $(GNUSTEP_MAKEFILES)/Additional/gui.make
+# $(GUIX_GNUSTEP_MAKEFILES_ADDITIONAL)/gui.make
 #
 ifeq ($(GUI_LIB), nx)
   GUI_DEFINE = -DNeXT_GUI_LIBRARY=1
