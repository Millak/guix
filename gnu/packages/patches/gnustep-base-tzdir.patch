From 67670de8dd26d03d77cf41432e5b4322b39fc16c Mon Sep 17 00:00:00 2001
From: rfm <richardfrithmacdonald@gmail.com>
Date: Fri, 29 May 2026 10:50:54 +0100
Subject: [PATCH] Allow TZDIR environment varibale to define timezone location

---
 Source/NSTimeZone.m | 10 +++++++++-
 1 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/Source/NSTimeZone.m b/Source/NSTimeZone.m
index 3685ea83c..dd39990a1 100644
--- a/Source/NSTimeZone.m
+++ b/Source/NSTimeZone.m
@@ -2465,6 +2465,7 @@ @implementation NSTimeZone (Private)
  * Common locations for timezone info on unix systems.
  */
 static NSString *zoneDirs[] = {
+  nil,		// Populate from TZDIR environment variable
 #ifdef TZDIR
   @TZDIR,
 #endif
@@ -2494,13 +2495,20 @@ + (NSString*) _getTimeZoneFile: (NSString *)name
 	  NSString	*zonedir = nil;
 	  unsigned	i;
 
+	  if (nil == zoneDirs[0])
+	    {
+	      zoneDirs[0] = RETAIN([[[NSProcessInfo processInfo] environment]
+		objectForKey: @"TZDIR"]);
+	    }
 	  for (i = 0; i < sizeof(zoneDirs)/sizeof(zoneDirs[0]); i++)
 	    {
 	      BOOL	isDir;
 
 	      zonedir
 		= [zoneDirs[i] stringByAppendingPathComponent: POSIX_TZONES];
-	      if ([mgr fileExistsAtPath: zonedir isDirectory: &isDir] && isDir)
+	      if (zonedir
+		&& [mgr fileExistsAtPath: zonedir isDirectory: &isDir]
+		&& isDir)
 		{
 		  tzdir = RETAIN(zonedir);
 		  break;  // use first one
