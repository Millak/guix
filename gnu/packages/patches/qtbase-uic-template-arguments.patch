From 7368673cc7cdf41324e75eb440263f5aca5e80e9 Mon Sep 17 00:00:00 2001
From: Jarek Kobus <jaroslaw.kobus@qt.io>
Date: Thu, 15 Oct 2026 09:10:14 +0200
Subject: [PATCH] uic: Allow template arguments in widget class names

The stricter class name validation rejected promoted widgets with
template arguments, such as "ItemViewSized<QListView>", which uic
accepted before. Allow '<', '>', ',' and space in the class of a
widget. The class of the form and the pixmap function stay strict, and
characters that could be used for code injection remain rejected.

Add a baseline test with a templated custom widget and an invalid file
test with an injection attempt.

Fixes: QTBUG-151379
Pick-to: 6.12
Change-Id: I23529e12d87ed0f028a1b71724b0159ca6c14ec1
Reviewed-by: Friedemann Kleint <Friedemann.Kleint@qt.io>
---
 src/tools/uic/validator.cpp                   | 14 ++++-
 .../auto/tools/uic/baseline/templatewidget.ui | 20 +++++++
 .../tools/uic/baseline/templatewidget.ui.h    | 56 +++++++++++++++++++
 .../tools/uic/invalid/bad_templateclass.ui    |  5 ++
 tests/auto/tools/uic/tst_uic.cpp              |  5 +-
 5 files changed, 95 insertions(+), 5 deletions(-)
 create mode 100644 tests/auto/tools/uic/baseline/templatewidget.ui
 create mode 100644 tests/auto/tools/uic/baseline/templatewidget.ui.h
 create mode 100644 tests/auto/tools/uic/invalid/bad_templateclass.ui

diff --git a/src/tools/uic/validator.cpp b/src/tools/uic/validator.cpp
index d976bbfbb5ff..41c73c83d196 100644
--- a/src/tools/uic/validator.cpp
+++ b/src/tools/uic/validator.cpp
@@ -79,10 +79,18 @@ static bool isClassNameContinuation(QChar c)
     return c == u':' || c == u'.' || isIdContinuation(c);
 }
 
-static bool checkClassName(QStringView name)
+// Template arguments of promoted widgets, e.g. "ItemViewSized<QListView>"
+static bool isTemplateClassNameContinuation(QChar c)
 {
+    return c == u'<' || c == u'>' || c == u',' || c == u' ' || isClassNameContinuation(c);
+}
+
+static bool checkClassName(QStringView name, bool allowTemplates = false)
+{
+    const auto isValid = allowTemplates ? isTemplateClassNameContinuation
+                                        : isClassNameContinuation;
     return !name.isEmpty() && isIdStart(name.at(0))
-            && std::all_of(name.cbegin() + 1, name.cend(), isClassNameContinuation);
+            && std::all_of(name.cbegin() + 1, name.cend(), isValid);
 }
 
 // Sanity check: A coarse check for any characters that would allow a code injection (C++/Python)
@@ -189,7 +197,7 @@ void Validator::acceptWidget(DomWidget *node)
 
     checkProperties(node->elementProperty(), &m_errors);
 
-    if (!checkClassName(node->attributeClass()))
+    if (!checkClassName(node->attributeClass(), true))
         m_errors.append(msgInvalidClassName(node->attributeClass()));
 
     TreeWalker::acceptWidget(node);
